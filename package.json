{
	"name": "anzaeee.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"repository": "https://github.com/anzaeee/anzaeee.github.io/",
	"homepage": "https://anzaeee.github.io/",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"predeploy": "npm run build",
		"deploy": "npm run build && cp -r build/* ../anzaeee.github.io && cd ../anzaeee.github.io && git add . && git commit -m 'deploy' && git push origin main"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"gh-pages": "^6.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	}
}
